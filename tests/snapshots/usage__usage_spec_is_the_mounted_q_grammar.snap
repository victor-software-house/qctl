---
source: tests/usage.rs
---
name q
bin q
version "<version>"
about "Control in-repo YAML work queues"
unknown_flags error
arg_required_else_help #true
args_override_self #false
subcommand_required #true
usage "Usage: q [OPTIONS] <COMMAND>"
flag --format help="Output representation" global=#true help_heading=Output default=pretty {
    arg <FORMAT> {
        choices {
            choice pretty help="Human text, optionally colored"
            choice json help="Machine JSON. Never contains ANSI"
        }
    }
}
flag "-q --quiet" help="Suppress successful pretty output" global=#true help_heading=Output
flag --color help="Pretty-output color policy. JSON never contains ANSI" global=#true help_heading=Output default=auto {
    arg <COLOR> {
        choices {
            choice auto help="Honor the stream: color if it is a TTY"
            choice always help="Always emit ANSI"
            choice never help="Never emit ANSI"
        }
    }
}
flag --no-color help="Force colorless pretty output. Wins over `--color`" global=#true help_heading=Output
cmd init display_order=0 args_override_self=#false help="Write a tasks.yaml for a prefix. Does not copy a schema file" unknown_flags=error {
    flag "-p --prefix" help="Stable id prefix, such as QCTL, VER, or FRK" required=#true {
        arg <PREFIX>
    }
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-F --force" help="Overwrite an existing ledger"
    complete file type=path
}
cmd status display_order=1 args_override_self=#false help="Print the active task and the priority-ordered queue" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    complete file type=path
}
cmd check display_order=2 args_override_self=#false help="Validate schema, graph, and git trailers that closed still-queued ids" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-g --no-git" help="Skip the git trailer scan. Needed for a scratch ledger that is not in the current repository"
    complete file type=path
}
cmd add display_order=3 args_override_self=#false help="Add a task to the queue, or to the horizon" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-t --title" help="One-line name of the task" required=#true {
        arg <TITLE>
    }
    flag "-s --scope" help="The part of the repository the task touches" required=#true {
        arg <SCOPE>
    }
    flag "-o --outcome" help="What is true once the task is done" required=#true {
        arg <OUTCOME>
    }
    flag "-a --acceptance" help="Repeatable end condition that must be demonstrably true to close the row. Required on the queue; not used on the horizon" var=#true {
        arg <ACCEPTANCE>… var=#true
    }
    flag "-P --patch" help="The forkctl patch the task edits" {
        arg <PATCH>
    }
    flag "-n --note" help="Repeatable note item. Intentional line and paragraph breaks are preserved" var=#true {
        arg <NOTE>… var=#true
    }
    flag "-b --blocked-by" help="Repeatable blocker id. Each must sit earlier than the new row" var=#true {
        arg <BLOCKED_BY>… var=#true
    }
    flag "-l --plan" help="A plan file next to the ledger, such as a change proposal" {
        arg <PLAN>
    }
    flag "-L --link" help="Repeatable URI" var=#true {
        arg <LINKS>… var=#true
    }
    flag "-A --after" help="Place the new row immediately after this queued id" {
        conflicts "--before" "--horizon"
        arg <AFTER>
    }
    flag "-B --before" help="Place the new row immediately before this queued id" {
        conflicts "--after" "--horizon"
        arg <BEFORE>
    }
    flag "-H --horizon" help="Write a horizon row instead of a queue row"
    flag "-k --kind" help="Why it is on the horizon. Required with --horizon" {
        arg <KIND>
    }
    flag "-O --open" help="The missing start condition. Required with --horizon" {
        arg <OPEN>
    }
    complete file type=path
}
cmd start display_order=4 args_override_self=#false help="Make one unblocked queued task active (moves it to queue head)" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    arg <ID> help="The task id, such as QCTL-001"
    complete file type=path
}
cmd archive display_order=5 args_override_self=#false help="Move a queued task to the archive" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-e --evidence" help="Repeatable evidence line" required=#true var=#true {
        arg <EVIDENCE>… var=#true
    }
    flag "-d --disposition" help="Whether the work was done or dropped" default=completed {
        arg <DISPOSITION> {
            choices {
                choice completed help="The work is done"
                choice dropped help="The work will not be done"
            }
        }
    }
    arg <ID> help="The queued task id"
    complete file type=path
}
cmd park display_order=6 args_override_self=#false help="Demote a queued task onto the horizon" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-k --kind" help="Why it goes on the horizon: research, evaluation, or deferred" required=#true {
        arg <KIND>
    }
    flag "-O --open" help="The missing start condition" required=#true {
        arg <OPEN>
    }
    arg <ID> help="The queued task id"
    complete file type=path
}
cmd promote display_order=7 args_override_self=#false help="Move a horizon row onto the queue" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-a --acceptance" help="Repeatable end condition that must be demonstrably true to close the promoted row" required=#true var=#true {
        arg <ACCEPTANCE>… var=#true
    }
    flag "-b --blocked-by" help="Repeatable blocker id. Each must already sit on the queue" var=#true {
        arg <BLOCKED_BY>… var=#true
    }
    arg <ID> help="The horizon task id"
    complete file type=path
}
cmd edit display_order=8 args_override_self=#false help="Rewrite fields or queue position of an existing row" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-t --title" help="New title" {
        arg <TITLE>
    }
    flag "-s --scope" help="New scope" {
        arg <SCOPE>
    }
    flag "-o --outcome" help="New outcome" {
        arg <OUTCOME>
    }
    flag "-k --kind" help="New horizon kind: research, evaluation, or deferred" {
        arg <KIND>
    }
    flag "-O --open" help="New missing start condition of a horizon row" {
        arg <OPEN>
    }
    flag "-P --patch" help="New forkctl patch name" {
        arg <PATCH>
    }
    flag "-l --plan" help="New plan file next to the ledger" {
        arg <PLAN>
    }
    flag "-U --unset" help="Drop `patch` or `plan`" var=#true {
        arg <UNSET>… var=#true {
            choices {
                choice patch help="The forkctl patch name"
                choice plan help="The plan file"
            }
        }
    }
    flag "-a --acceptance" help="Repeatable end condition that must be demonstrably true to close the row" var=#true {
        arg <ACCEPTANCE>… var=#true
    }
    flag "-n --note" help="Repeatable note item to append. Intentional line and paragraph breaks are preserved" var=#true {
        arg <NOTE>… var=#true
    }
    flag "-L --link" help="Repeatable URI to append" var=#true {
        arg <LINKS>… var=#true
    }
    flag "-b --blocked-by" help="Repeatable blocker id to append" var=#true {
        arg <BLOCKED_BY>… var=#true
    }
    flag "-e --evidence" help="Repeatable evidence line to append" var=#true {
        arg <EVIDENCE>… var=#true
    }
    flag "-x --remove" help="Remove one list item as `field:index` or `field:exact text`" var=#true {
        arg <REMOVE>… var=#true
    }
    flag "-R --reorder-notes" help="Permutation of 1-based note indexes, such as `3,1,2`" {
        arg <REORDER_NOTES>
    }
    flag "-p --position" help="Move this queued row to `front`, `back`, `before:ID`, or `after:ID`" {
        arg <POSITION>
    }
    arg <ID> help="The task id, on any list"
    complete file type=path
}
cmd show display_order=9 args_override_self=#false help="Print one queued, archived, or horizon task" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    arg <ID> help="The task id, such as QCTL-001"
    complete file type=path
}
cmd fmt display_order=10 args_override_self=#false help="Rewrite a ledger into the style it declares. Upgrades schema 3 to 4" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-c --check" help="Say what is not in the declared style and exit non-zero, writing nothing"
    complete file type=path
}
cmd close-from-git display_order=11 args_override_self=#false help="Archive queued ids that commit-body trailers closed" unknown_flags=error {
    flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
        arg <FILE>
    }
    flag "-u --pre-push" help="Read pre-push stdin (`<local-ref> <local-sha> <remote-ref> <remote-sha>`)"
    flag "-r --range" help="`git log` revision range, such as `main..HEAD`. Default: the whole history, same as `check`" conflicts=--pre-push {
        arg <RANGE>
    }
    complete file type=path
}
cmd hook display_order=12 subcommand_required=#true arg_required_else_help=#true args_override_self=#false help="Install git hooks for this ledger" unknown_flags=error {
    cmd install display_order=0 args_override_self=#false help="Write `.git/hooks/pre-push` so a push archives closed ids" unknown_flags=error {
        flag "-f --file" help="Ledger path. Defaults to `TASKS_LEDGER`, then `tasks.yaml`" {
            arg <FILE>
        }
        flag "-F --force" help="Overwrite an existing git pre-push. Rejected when Lefthook is present and does not already run close-from-git"
        complete file type=path
    }
}
cmd schema display_order=13 args_override_self=#false help="Write schema/tasks.schema.json from the ledger types" unknown_flags=error {
    flag "-o --out" help="Where to write it. Defaults to schema/tasks.schema.json" {
        arg <OUT>
    }
    complete out type=path
}
cmd instructions display_order=14 args_override_self=#false help="Print the installed-version operator contract" unknown_flags=error
